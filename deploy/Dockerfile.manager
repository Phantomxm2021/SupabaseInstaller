FROM node:24-alpine AS web-build
WORKDIR /src
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
RUN npm ci
COPY apps/web apps/web
RUN npm run build --workspace apps/web

FROM golang:1.27-alpine AS go-build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=web-build /src/apps/web/dist/ /src/apps/manager/webdist/dist/
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/manager ./apps/manager/cmd/manager

FROM alpine:3.22
RUN apk add --no-cache ca-certificates wget \
    && addgroup -S manager \
    && adduser -S -G manager -u 10001 manager \
    && mkdir -p /var/lib/supabase-manager \
    && chown manager:manager /var/lib/supabase-manager
COPY --from=go-build /out/manager /usr/local/bin/manager
USER manager
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/manager"]
