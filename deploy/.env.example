# Generate both values; never reuse them across hosts.
MASTER_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
PROVISIONER_TOKEN=replace-with-openssl-rand-hex-32

MANAGER_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
SECURE_COOKIES=false
PORT_RANGE_START=8000
PORT_RANGE_END=8999

# Must be an absolute host path shared with Docker Desktop. It is mounted at
# the identical path so project Compose bind mounts resolve on the host daemon.
PROJECT_ROOT=/Users/Shared/supabase-manager/projects
