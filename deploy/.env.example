# Replace both placeholders with freshly generated values; startup rejects
# these placeholders and refuses to run with them.
# MASTER_ENCRYPTION_KEY must decode to exactly 32 bytes.
MASTER_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32
# The same 32+ byte token is injected as MANAGER_TOKEN into the private
# Provisioner container by docker-compose; it is never sent to the browser.
PROVISIONER_TOKEN=replace-with-output-of-openssl-rand-hex-32
# Generate a different value from PROVISIONER_TOKEN; it is shared solely by
# Provisioner and the native Nginx agent through their private Unix socket.
NGINX_PROXY_TOKEN=replace-with-output-of-openssl-rand-hex-32

MANAGER_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
SECURE_COOKIES=false
PORT_RANGE_START=8000
PORT_RANGE_END=8999
# MANAGER_IMAGE_TAG also selects the exact Provisioner image used by each
# project's private Function log collector.
MANAGER_IMAGE_TAG=local

# Must be an absolute host path shared with Docker Desktop. It is mounted at
# the identical path so project Compose bind mounts resolve on the host daemon.
PROJECT_ROOT=/Users/Shared/supabase-manager/projects

# The one-command Ubuntu installer replaces these defaults with managed mode
# and the host's /run directory. Keep disabled for manual proxy development.
NGINX_PROXY_MODE=disabled
NGINX_PROXY_SOCKET=/run/supabase-manager/nginx-proxy-agent.sock
NGINX_PROXY_SOCKET_DIRECTORY=/tmp/supabase-manager-nginx-socket
