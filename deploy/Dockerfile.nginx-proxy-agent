FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/nginx-proxy-agent ./apps/nginxproxy/cmd/nginx-proxy-agent

FROM scratch AS export
COPY --from=build /out/nginx-proxy-agent /nginx-proxy-agent
