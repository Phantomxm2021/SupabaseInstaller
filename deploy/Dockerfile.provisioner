FROM golang:1.27-alpine AS go-build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/provisioner ./apps/provisioner/cmd/provisioner

FROM docker:29-cli
RUN apk add --no-cache ca-certificates wget docker-cli-compose
COPY --from=go-build /out/provisioner /usr/local/bin/provisioner
EXPOSE 9090
ENTRYPOINT ["/usr/local/bin/provisioner"]
